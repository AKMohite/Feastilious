<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="@dimen/space_small">

    <ImageView
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginHorizontal="@dimen/space_medium"
        android:contentDescription="@string/onboarding_pager"
        android:src="@drawable/ic_recipe_img_placeholder"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/pager_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Pager title"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:layout_marginTop="@dimen/space_big"
            android:gravity="center"/>

        <TextView
            android:id="@+id/pager_sub_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Pager sub title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:layout_marginTop="@dimen/space_normal"
            android:gravity="center"/>
    </LinearLayout>



</LinearLayout>