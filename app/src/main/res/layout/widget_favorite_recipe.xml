<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:padding="@dimen/space_small"
  xmlns:tools="http://schemas.android.com/tools">
  <ImageView
    android:id="@+id/widget_fav_recipe_img"
    android:layout_width="@dimen/widget_img_height"
    android:layout_height="@dimen/widget_img_height"
    android:contentDescription="@string/content_desc_recipe_image"
    android:scaleType="centerCrop"
    android:src="@drawable/recipe_default_placeholder"
    tools:srcCompat="@tools:sample/backgrounds/scenic"/>
  <TextView
    android:id="@+id/widget_fav_recipe_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:text="@string/lorem_ipsum"
    android:maxLines="2"
    android:layout_marginHorizontal="@dimen/space_small"
    android:layout_toEndOf="@id/widget_fav_recipe_img"
    style="?attr/textAppearanceBodyMedium"/>
</RelativeLayout>
