<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">
    <!--TODO handle splash and onboarding screen-->
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.ak.feastit.ui.splash.SplashFragment"
        android:label="splash_fragment"
        tools:layout="@layout/splash_fragment" >
        <action
            android:id="@+id/action_splashFragment_to_onBoardingFragment"
            app:destination="@id/onBoardingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_recipeDashboardFragment"
            app:destination="@id/exploreFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.ak.feastit.ui.explore.ExploreFragment"
        android:label="explore_fragment"
        tools:layout="@layout/fragment_explore">
        <action
            android:id="@+id/explore_to_recipeDetail"
            app:destination="@id/recipeDetailFragment"/>
    </fragment>

    <fragment
        android:id="@+id/onBoardingFragment"
        android:name="com.ak.feastit.ui.onboarding.OnBoardingFragment"
        android:label="fragment_on_boarding"
        tools:layout="@layout/fragment_on_boarding" >
        <action
            android:id="@+id/action_onBoardingFragment_to_recipeDashboardFragment"
            app:destination="@id/exploreFragment"
            app:popUpTo="@id/onBoardingFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/recipeDetailFragment"
        android:name="com.ak.feastit.ui.yumdetail.YumDetailFragment"
        android:label="recipe_detail_fragment"
        tools:layout="@layout/fragment_yum_detail" >
        <argument
            android:name="recipeId"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/collectionFragment"
        android:name="com.ak.feastit.ui.collection.CollectionFragment"
        android:label="collection_fragment"
        tools:layout="@layout/fragment_collections">
        <action
            android:id="@+id/collection_to_favorites"
            app:destination="@id/favoriteRecipesFragment"/>

        <action
            android:id="@+id/collection_to_shopping"
            app:destination="@id/shoppingCartFragment"/>

        <action
            android:id="@+id/collection_to_meal_planner"
            app:destination="@id/favoriteRecipesFragment"/>
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.ak.feastit.ui.collection.CollectionFragment"
        android:label="collection_fragment"
        tools:layout="@layout/fragment_collections"/>

    <fragment
        android:id="@+id/favoriteRecipesFragment"
        android:name="com.ak.feastit.ui.favorites.FavoriteRecipesFragment"
        android:label="favorite_recipes_fragment"
        tools:layout="@layout/fragment_favorites">
        <action
            android:id="@+id/favRecipes_to_recipeDetail"
            app:destination="@id/recipeDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/shoppingCartFragment"
        android:name="com.ak.feastit.ui.cart.ShoppingCartFragment"
        android:label="shopping_list_fragment"
        tools:layout="@layout/fragment_shopping_cart"
        />
</navigation>